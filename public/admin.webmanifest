{
  "id": "/admin",
  "name": "RK Admin",
  "short_name": "RK Admin",
  "description": "Private control plane for ravikishan.me — site content, résumé, document vault, job tracker and writing.",
  "start_url": "/admin?source=pwa",
  "scope": "/admin",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#0d0e13",
  "theme_color": "#0d0e13",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/admin-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/admin-icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Vault",
      "short_name": "Vault",
      "url": "/admin?tab=vault",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Jobs",
      "short_name": "Jobs",
      "url": "/admin?tab=jobs",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Writing",
      "short_name": "Writing",
      "url": "/admin?tab=posts",
      "icons": [{ "src": "/admin-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
